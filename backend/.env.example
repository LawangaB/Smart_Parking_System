# Copy this file to ".env" and adjust the values. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_parking_db
DB_USER=root
DB_PASSWORD=your_password

# Authentication (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins (the React dev server by default)
CORS_ORIGIN=http://localhost:5173

# Max login/register requests per IP per 15 minutes (lower this in production)
AUTH_RATE_LIMIT_MAX=50

# Used only by `npm run db:seed` to create demo accounts (development only)
ADMIN_EMAIL=admin@smartparking.local
ADMIN_PASSWORD=Admin@12345
DEMO_CUSTOMER_EMAIL=customer@smartparking.local
DEMO_CUSTOMER_PASSWORD=Customer@12345
